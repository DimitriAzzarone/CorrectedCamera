<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.CorrectedCamera" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#101418</item>
        <item name="android:statusBarColor">#101418</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="colorAccent">#55D6BE</item>
    </style>

    <style name="CorrectedCameraButton.Primary" parent="Widget.Material3.Button">
        <item name="android:textColor">#F4F7F8</item>
        <item name="backgroundTint">#28323A</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="CorrectedCameraButton.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">#D8E0E6</item>
        <item name="strokeColor">#45525C</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="CorrectedCameraButton.Accent" parent="Widget.Material3.Button">
        <item name="android:textColor">#07110F</item>
        <item name="backgroundTint">#55D6BE</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
